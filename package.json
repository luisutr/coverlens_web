{
  "name": "coverlens-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "powershell -ExecutionPolicy Bypass -File scripts/dev-lan.ps1",
    "preview:lan": "npm run build && vite preview --host",
    "firewall:lan": "powershell -ExecutionPolicy Bypass -File scripts/open-firewall-lan.ps1",
    "dev:api": "powershell -ExecutionPolicy Bypass -File scripts/dev-api.ps1",
    "dev:api:mac": "bash scripts/dev-api.sh",
    "dev:api:lan": "powershell -ExecutionPolicy Bypass -File scripts/dev-api.ps1 -Lan",
    "deploy:local-edits": "powershell -ExecutionPolicy Bypass -File scripts/deploy-local-edits.ps1",
    "deploy:local-edits:mac": "bash scripts/deploy-local-edits.sh",
    "deploy:web": "npm run build && python3 scripts/deploy-web-vps.py",
    "deploy:prod": "bash ../coverlens_resource/scripts/deploy-prod.sh admin-web",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-x64": "^4.60.4"
  }
}
